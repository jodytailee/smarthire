# Supabase (proyecto nuevo, exclusivo de SmartHire — no compartir con EasyGo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude — scoring de postulantes, correos de rechazo/futuro-candidato,
# generación de descripciones y preguntas de puesto. Si falta, esas funciones
# degradan sin romper el flujo (igual que en EasyGo).
ANTHROPIC_API_KEY=

# Correo saliente — se usa el primero que esté configurado: Resend, si no Gmail SMTP.
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Calendar — opcional. Sin esto, agendar entrevista sigue funcionando pero
# sin link de Meet. Client OAuth de Google Cloud Console, scope calendar.events.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# URL pública del sitio (usada para armar links en correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000
